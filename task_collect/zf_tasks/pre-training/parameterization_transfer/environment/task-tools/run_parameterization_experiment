#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Run one candidate-visible parameterization experiment.

Usage:
  run_parameterization_experiment --attempt-id ID --scale E0 \
    --recipe /app/project/parameterization_transfer.py --hypothesis-file FILE \
    [--resume-checkpoint DIR] [--dry-run]
EOF
}

attempt_id=
scale=
recipe=
hypothesis_file=
resume_checkpoint=
dry_run=0
while (( $# > 0 )); do
    case "$1" in
        --attempt-id) attempt_id=${2:-}; shift 2 ;;
        --scale) scale=${2:-}; shift 2 ;;
        --recipe) recipe=${2:-}; shift 2 ;;
        --hypothesis-file) hypothesis_file=${2:-}; shift 2 ;;
        --resume-checkpoint) resume_checkpoint=${2:-}; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

[[ ${recipe} == /app/project/parameterization_transfer.py && -f ${recipe} ]] || {
    printf 'error: --recipe must be /app/project/parameterization_transfer.py\n' >&2
    exit 2
}
command=("$(dirname -- "${BASH_SOURCE[0]}")/run_parameterization_scaling_ladder.sh"
    --attempt-id "${attempt_id}" --scale "${scale}" --hypothesis-file "${hypothesis_file}")
[[ -z ${resume_checkpoint} ]] || command+=(--resume-checkpoint "${resume_checkpoint}")
(( dry_run == 0 )) || command+=(--dry-run)
exec "${command[@]}"
