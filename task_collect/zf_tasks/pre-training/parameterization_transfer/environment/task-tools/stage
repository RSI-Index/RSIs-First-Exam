#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: stage --attempt-id ID [--hypothesis-file /app/output/HYPOTHESIS.md]\n'
}

attempt_id=
hypothesis_file=/app/output/HYPOTHESIS.md
while (( $# > 0 )); do
    case "$1" in
        --attempt-id) attempt_id=${2:-}; shift 2 ;;
        --hypothesis-file) hypothesis_file=${2:-}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done
[[ ${attempt_id} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]] || {
    printf 'error: --attempt-id is required and must be a safe identifier\n' >&2
    exit 2
}
exec python "$(dirname -- "${BASH_SOURCE[0]}")/parameterization_scaling_task.py" stage \
    --attempt "/app/output/attempts/${attempt_id}" \
    --hypothesis-file "${hypothesis_file}" \
    --project /app/project
