Bootstrap: localimage
From: @ENVIRONMENT_SIF@

%labels
    org.opencontainers.image.title "Parameterization scaling-ladder Harbor verifier"

%files
    tests/ /
    task-tools/ /

%post
    set -eux
    chmod a+x /tests/test.sh /tests/policy_check.py /tests/validate_submission.py /tests/score.py
    chmod a+x /task-tools/run_parameterization_scaling_ladder.sh /task-tools/run_parameterization_candidate_ladder.sh
    chmod a+x /task-tools/run_parameterization_experiment /task-tools/summarize_experiment
    chmod a+x /task-tools/freeze_parameterization /task-tools/stage
    chmod a+x /task-tools/parameterization_scaling_task.py /task-tools/host_lease.py
    mkdir -p /logs/verifier
    /opt/venv/bin/python -c "import yaml"

%test
    set -eu
    test -f /opt/project/examples/training/parameterization/runtime/lm_eval_runner.py
    test -z "$(find /opt/project/examples/training -mindepth 1 -maxdepth 1 ! -name parameterization -print -quit)"
    test -z "$(find /app/project/examples/training -mindepth 1 -maxdepth 1 ! -name parameterization -print -quit)"
    test -x /tests/test.sh
    test -x /task-tools/run_parameterization_scaling_ladder.sh
    test -x /task-tools/run_parameterization_candidate_ladder.sh
    test -x /task-tools/run_parameterization_experiment
    test -x /task-tools/summarize_experiment
    test -x /task-tools/freeze_parameterization
    test -x /task-tools/stage

%runscript
    exec "$@"
