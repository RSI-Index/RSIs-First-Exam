Bootstrap: localimage
From: @ENVIRONMENT_SIF@

%labels
    org.opencontainers.image.title "Optimizer scaling-ladder Harbor verifier"

%files
    tests/ /
    task-tools/ /

%post
    set -eux
    chmod a+x /tests/test.sh /tests/policy_check.py /tests/validate_submission.py /tests/score.py
    chmod a+x /task-tools/run_optimizer_scaling_ladder.sh /task-tools/run_optimizer_candidate_ladder.sh
    chmod a+x /task-tools/optimizer_scaling_task.py /task-tools/host_lease.py
    mkdir -p /logs/verifier
    /opt/venv/bin/python -c "import yaml"

%test
    set -eu
    test -f /opt/project/examples/training/optimizer/runtime/lm_eval_runner.py
    test -z "$(find /opt/project/examples/training -mindepth 1 -maxdepth 1 ! -name optimizer -print -quit)"
    test -z "$(find /app/project/examples/training -mindepth 1 -maxdepth 1 ! -name optimizer -print -quit)"
    test -x /tests/test.sh
    test -x /task-tools/run_optimizer_scaling_ladder.sh
    test -x /task-tools/run_optimizer_candidate_ladder.sh

%runscript
    exec "$@"
