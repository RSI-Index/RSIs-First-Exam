Bootstrap: localimage
From: @BASE_RUNTIME_SIF@

%labels
    org.opencontainers.image.title "Six-scale learning-rate Harbor environment"
    org.opencontainers.image.source "NVIDIA-NeMo/Megatron-Bridge@accefd7b3a448ab45b015edc04c9d3b70f7cb3b7"
    org.opencontainers.image.revision "3a6c6fb3811a10f532d26be7dd032457795a8e41"
    org.opencontainers.image.description "Learning-rate schedule transfer from 550M through 2.545B in one 256-GPU allocation"

%files
    lr-schedule-project/ /opt/lr-schedule-project
    task-tools/ /task-tools

%post
    set -eux

    # Reuse the prepared CUDA/PyTorch/Bridge environment, but replace its
    # source checkout with the isolated working-tree snapshot. The agent never
    # sees or modifies the host checkout.
    rm -rf /opt/Megatron-Bridge /opt/project /app/project
    mv /opt/lr-schedule-project /opt/Megatron-Bridge

    # Apptainer's %files stage dereferences repository symlinks. Reconstruct
    # every mode-120000 entry from the pinned synthetic Git commit before
    # cloning the clean and writable project trees. Source inventories include
    # entry kinds, so flattened links would otherwise make the first frozen
    # candidate impossible to materialize from /opt/project.
    /opt/venv/bin/python - <<'PY'
import os
import shutil
import subprocess
from pathlib import Path

root = Path("/opt/Megatron-Bridge")
entries = subprocess.check_output(
    ["git", "-C", str(root), "ls-files", "-s", "-z"]
).split(b"\0")
for entry in entries:
    if not entry:
        continue
    metadata, raw_relative = entry.split(b"\t", 1)
    if metadata.split()[0] != b"120000":
        continue
    relative = os.fsdecode(raw_relative)
    target = subprocess.check_output(
        ["git", "-C", str(root), "show", f"HEAD:{relative}"]
    ).decode()
    destination = root / relative
    if destination.is_dir() and not destination.is_symlink():
        shutil.rmtree(destination)
    else:
        destination.unlink(missing_ok=True)
    destination.symlink_to(target)
PY
    chmod -R a+rX /opt/Megatron-Bridge /task-tools
    chmod a+x /task-tools/run_lr_schedule_ladder.sh /task-tools/run_lr_schedule_candidate_ladder.sh
    chmod a+x /task-tools/lr_schedule_task.py /task-tools/host_lease.py

    mkdir -p /app/output /logs/verifier
    cp -a /opt/Megatron-Bridge /opt/project
    cp -a /opt/project /app/project

    test -x /opt/venv/bin/python
    test -L /opt/Megatron-Bridge/CLAUDE.md
    test -L /opt/Megatron-Bridge/3rdparty/Megatron-LM/CLAUDE.md
    test -L /app/project/CLAUDE.md
    test -L /app/project/3rdparty/Megatron-LM/CLAUDE.md
    test -f /app/project/examples/training/lr_schedule/runtime/pretrain_gpt_marin_adamh.py
    test -f /app/project/examples/training/lr_schedule/runtime/lr_schedule_candidate.py
    grep -F 'container_script="$container_repo_dir/examples/training/lr_schedule"' \
        /app/project/examples/training/lr_schedule/run_marin_adamh_bluevela_lsf.sh
    ! grep -F 'container_script="$container_repo_dir/examples/training/baseline"' \
        /app/project/examples/training/lr_schedule/run_marin_adamh_bluevela_lsf.sh
    test -z "$(find /app/project/examples/training -mindepth 1 -maxdepth 1 ! -name lr_schedule -print -quit)"

%environment
    export PATH="/opt/venv/bin:/root/.local/bin:$PATH"
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export VIRTUAL_ENV=/opt/venv
    export UV_LINK_MODE=copy
    export UV_HTTP_TIMEOUT=120
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export WANDB_MODE=offline
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export NVTE_BUILD_NUM_PHILOX_ROUNDS=3
    export HYBRID_EP_MULTINODE=1
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"

%test
    set -eu
    test -x /opt/venv/bin/python
    test -x /usr/local/bin/uv
    test -L /opt/Megatron-Bridge/CLAUDE.md
    test -L /opt/Megatron-Bridge/3rdparty/Megatron-LM/CLAUDE.md
    test -L /app/project/CLAUDE.md
    test -L /app/project/3rdparty/Megatron-LM/CLAUDE.md
    test -f /opt/Megatron-Bridge/examples/training/lr_schedule/runtime/lm_eval_runner.py
    test -z "$(find /opt/Megatron-Bridge/examples/training -mindepth 1 -maxdepth 1 ! -name lr_schedule -print -quit)"
    test -z "$(find /app/project/examples/training -mindepth 1 -maxdepth 1 ! -name lr_schedule -print -quit)"
    test -x /task-tools/run_lr_schedule_ladder.sh
    test -x /task-tools/run_lr_schedule_candidate_ladder.sh
    test -f /opt/Megatron-Bridge/examples/training/lr_schedule/runtime/lr_schedule_candidate.py
    grep -F 'container_script="$container_repo_dir/examples/training/lr_schedule"' \
        /opt/Megatron-Bridge/examples/training/lr_schedule/run_marin_adamh_bluevela_lsf.sh
    ! grep -F 'container_script="$container_repo_dir/examples/training/baseline"' \
        /opt/Megatron-Bridge/examples/training/lr_schedule/run_marin_adamh_bluevela_lsf.sh
    /opt/venv/bin/python -c "import importlib.util, lm_eval, yaml; assert importlib.util.find_spec('megatron.core')"

%runscript
    exec "$@"
