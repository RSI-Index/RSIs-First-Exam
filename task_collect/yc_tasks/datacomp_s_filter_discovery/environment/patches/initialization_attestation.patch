@@ -0,0 +1,90 @@
+"""Read-only initialization evidence for fixed DataComp training runs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import struct
+import tempfile
+from pathlib import Path
+from typing import Any
+
+import torch
+
+
+def _framed_update(digest: "hashlib._Hash", value: bytes) -> None:
+    digest.update(struct.pack(">Q", len(value)))
+    digest.update(value)
+
+
+def fingerprint_state_dict(model: torch.nn.Module) -> dict[str, Any]:
+    """Hash tensor identity and bytes without changing tensors or RNG state."""
+    target = model.module if hasattr(model, "module") else model
+    digest = hashlib.sha256()
+    state = target.state_dict()
+
+    for name in sorted(state):
+        tensor = state[name].detach().cpu().contiguous()
+        _framed_update(digest, name.encode("utf-8"))
+        _framed_update(digest, str(tensor.dtype).encode("ascii"))
+        _framed_update(
+            digest,
+            json.dumps(list(tensor.shape), separators=(",", ":")).encode("ascii"),
+        )
+        raw = tensor.view(torch.uint8).numpy().tobytes(order="C")
+        _framed_update(digest, raw)
+
+    return {
+        "algorithm": "sha256-state-dict-v1",
+        "parameter_count": sum(
+            parameter.numel() for parameter in target.parameters()
+        ),
+        "sha256": digest.hexdigest(),
+        "tensor_count": len(state),
+    }
+
+
+def _atomic_json(path: Path, value: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temporary_name = tempfile.mkstemp(
+        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
+    )
+    temporary = Path(temporary_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(
+                value,
+                handle,
+                sort_keys=True,
+                separators=(",", ":"),
+                allow_nan=False,
+            )
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    except BaseException:
+        temporary.unlink(missing_ok=True)
+        raise
+
+
+def write_initialization_attestation(
+    model: torch.nn.Module, args: Any, log_base_path: str
+) -> dict[str, Any]:
+    """Write rank-0 evidence after model construction and before optimization."""
+    record = {
+        "distill_model": args.distill_model,
+        "distill_pretrained": args.distill_pretrained,
+        "fingerprint": fingerprint_state_dict(model),
+        "model": args.model,
+        "pretrained": args.pretrained,
+        "pretrained_image": args.pretrained_image,
+        "rank": args.rank,
+        "resume": args.resume,
+        "schema_version": 1,
+        "seed": args.seed,
+        "stage": "post-model-construction-pre-optimizer",
+    }
+    _atomic_json(Path(log_base_path) / "initialization_attestation.json", record)
+    return record
