# Algorithm: grpo, dppo, ppo, cispo, or tvpo.
RSI_RL_ALGORITHM=dppo

# Optimizer and update recipe.
RSI_RL_LEARNING_RATE=1e-6
RSI_RL_SCHEDULER=constant
RSI_RL_WARMUP_RATIO=0.0
RSI_RL_WEIGHT_DECAY=0.0
RSI_RL_MAX_GRAD_NORM=1.0
RSI_RL_NUM_EPOCHS=1
RSI_RL_NUM_MINI_BATCHES=1

# Policy loss, KL, entropy, and trust regions.
RSI_RL_CLIP_LOWER=0.2
RSI_RL_CLIP_HIGHER=0.272
RSI_RL_KL_COEF=0.0
RSI_RL_KL_ESTIMATOR=2
RSI_RL_ENTROPY_COEF=0.0
RSI_RL_DPPO_DIVERGENCE=tv
RSI_RL_DPPO_THRESHOLD=0.1
RSI_RL_TVPO_THRESHOLD=0.02
RSI_RL_TVPO_CAP=20.0
RSI_RL_TIS_CAP=0.0
RSI_RL_TIS_MASK_LOWER=0.0
RSI_RL_TIS_MASK_UPPER=0.0
RSI_RL_SEQUENCE_TIS_THRESHOLD=0.0
RSI_RL_LOSS_DENOMINATOR=token

# PPO value model and GAE. The value model always starts from the frozen base.
RSI_RL_VALUE_LEARNING_RATE=1e-6
RSI_RL_VALUE_LOSS_COEF=0.5
RSI_RL_VALUE_CLIP_RANGE=0.2
RSI_RL_GAMMA=1.0
RSI_RL_GAE_LAMBDA=1.0

# Sampling and asynchronous training. Unique prompts x group size must be 256.
RSI_RL_ROLLOUT_TEMPERATURE=1.0
RSI_RL_UNIQUE_PROMPTS=8
RSI_RL_GROUP_SIZE=32
RSI_RL_ASYNC_STEPS=4
RSI_RL_ACTIVE_SAMPLING=true
RSI_RL_FILTER_ZERO_STD=true
RSI_RL_INFLIGHT_UPDATES=true
RSI_RL_USE_VLLM_LOGPROBS=true
RSI_RL_USE_LIGER_LOSS=true

# Attempt length belongs to the research agent. Every integer from 1 through
# 200 is valid; only a 200-update attempt may be submitted.
TMAX_MAX_UPDATES=7
TMAX_SCHEDULER_HORIZON_UPDATES=200

# Editable training artifacts. The trusted runner hashes these paths before
# launch. Final evaluation does not import them.
TMAX_TRAINING_DATA_DIR=/app/training/data
TMAX_TRAINING_PROMPT_FILE=/app/training/prompt/system.txt
TMAX_TRAINING_REWARD_FILE=/app/training/reward/reward.py
