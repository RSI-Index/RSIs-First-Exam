         val_ds = train_ds.select(range(val_size))
         train_ds = train_ds.select(range(val_size, len(train_ds)))
 
+    # RSI ADAPTER (frozen). The round's selection, applied to TRAIN ONLY and AFTER the val split
+    # so that val is the same held-out slice in every round of every chain -- if selection ran
+    # first, each round would score its own val set and no cross-round comparison would hold.
+    # A missing or malformed keep list is a hard error: silently training on the whole pool would
+    # look like a completed round and read downstream as "selection had no effect".
+    if train_cfg.rsi_keep_list:
+        import json as _json
+        _spec = _json.loads(open(train_cfg.rsi_keep_list).read())
+        _keep = set(_spec["keep"])
+        _ids = train_ds["rsi_idx"]
+        _positions = [_p for _p, _i in enumerate(_ids) if _i in _keep]
+        if not _positions:
+            raise ValueError(
+                f"rsi_keep_list {train_cfg.rsi_keep_list} selected 0 of {len(_ids)} train rows; "
+                f"an empty curriculum trains silently and scores at the pristine base")
+        print(f"RSI keep list: {len(_positions)}/{len(_ids)} train rows "
+              f"({100.0*len(_positions)/len(_ids):.2f}%)")
+        train_ds = train_ds.select(_positions)
