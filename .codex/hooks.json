{
  "description": "Bind an activated RSI proposal to its native Codex session.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/proposal-agent/scripts/proposal_session.py\" hook --platform codex --checkout \"$(git rev-parse --show-toplevel)\""
          }
        ]
      }
    ]
  }
}
